{
  "name": "relay",
  "private": true,
  "version": "0.1.0",
  "description": "Relay — TRON payment infrastructure",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"services/*/src/**/*.test.ts\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "wallet:new-mnemonic": "node scripts/new-mnemonic.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:db": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "db:seed": "node scripts/seed.mjs",
    "api:dev": "npm run build && node --env-file-if-exists=.env services/api/dist/index.js",
    "db:reset": "node scripts/reset-db.mjs && npm run db:migrate",
    "indexer:dev": "npm run build && node --env-file-if-exists=.env services/indexer/dist/index.js",
    "webhooks:dev": "npm run build && node --env-file-if-exists=.env services/webhooks/dist/index.js",
    "sweeper:dev": "npm run build && node --env-file-if-exists=.env services/sweeper/dist/index.js",
    "contracts:build": "node contracts/compile.mjs",
    "contracts:test": "node contracts/compile.mjs && node --test \"contracts/*.test.mjs\"",
    "wallet:hot-address": "node scripts/hot-wallet-address.mjs",
    "console:dev": "npm run build && node --env-file-if-exists=.env services/console/dist/index.js",
    "console:create-operator": "node scripts/create-operator.mjs",
    "console:new-key": "node scripts/new-console-key.mjs",
    "console:web:build": "npm run build --workspace @relay/console-web",
    "console:web:dev": "npm run dev --workspace @relay/console-web"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@types/node": "^22.10.2",
    "solc": "^0.8.19",
    "tronweb": "^6.5.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}
