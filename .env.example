# ---------------------------------------------------------------------------
# Relay — local development environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Infrastructure (ports offset from defaults to avoid clashing with anything
# already running on this machine)
DATABASE_URL=postgres://relay:relay_local_dev@localhost:5433/relay
REDIS_URL=redis://localhost:6380

# TRON network: "nile" (testnet, free coins) or "mainnet" (real money)
TRON_NETWORK=nile
TRON_FULL_NODE=https://nile.trongrid.io

# USDT TRC20 contract address for the selected network
#   nile:    TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf
#   mainnet: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_CONTRACT=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# Master seed for deriving deposit addresses (BIP39 mnemonic, 24 words).
# Generate with: npm run wallet:new-mnemonic
# In production this NEVER lives in a file — it comes from a KMS/HSM.
WALLET_MNEMONIC=

# How many block confirmations before a payment is considered final
CONFIRMATIONS_REQUIRED=20

# How long a payment stays open waiting for funds
PAYMENT_TTL_MINUTES=15

# --- Sweeper -----------------------------------------------------------------
# Moving settled funds off deposit addresses to the merchant.

# Broadcasting is OFF unless this is exactly "true". A misconfigured sweeper
# that only builds and signs costs nothing; one that broadcasts by default can
# empty every deposit address before anyone reads a log line.
SWEEP_BROADCAST=false

# The TRX price comes from WINkLink, TRON's price oracle (USDT/TRX feed).
# Left empty, the official feed for TRON_NETWORK is used:
#   nile:    TVZjuqiJNNuLQAQoPAFfUqvYUxhZYkUX5Z
#   mainnet: TUfV7S4RYtdmBvtHzedfFPVsK9nvndtETp
# Source: doc.winklink.org/v2/doc/pricing.html. The sweeper checks the feed
# calls itself "USDT/TRX" every pass and refuses to start if it does not.
ORACLE_USDT_TRX=

# WINkLink updates USDT/TRX on a 1% move and otherwise every 24 hours, so a
# day-old price is normal. This must stay above that heartbeat. A price older
# than this pauses sweeps — never payouts — until a fresh one arrives.
ORACLE_MAX_AGE_HOURS=26

# Refuse a sweep whose network fee exceeds this share of the amount (bps).
SWEEP_MAX_FEE_BPS=500
# Never sweep less than this, whatever the fee works out to (base units).
SWEEP_MIN_UNITS=1000000

# Ceiling on what the network may charge for one sweep, in sun.
SWEEP_FEE_LIMIT_SUN=40000000

SWEEP_POLL_MS=30000
SWEEP_BATCH_SIZE=10

# --- Webhooks ----------------------------------------------------------------
WEBHOOK_POLL_MS=2000
WEBHOOK_BATCH_SIZE=20
WEBHOOK_TIMEOUT_MS=10000

# --- Indexer -----------------------------------------------------------------
INDEXER_POLL_MS=3000
INDEXER_BATCH_SIZE=25
INDEXER_START_BEHIND_HEAD=20

# Optional TronGrid key; public endpoints rate limit without one.
TRONGRID_API_KEY=

# The one wallet every user address is consolidated into. Required by the
# sweeper, and validated at startup: an unset or mistyped treasury is the
# difference between money arriving and money gone.
TREASURY_ADDRESS=

# --- Hot wallet and payouts --------------------------------------------------
# Payouts are signed by a hot wallet derived from WALLET_MNEMONIC on its own
# BIP44 account, m/44'/195'/1'/0/0, so it can never collide with a user's
# deposit address. Print it with: npm run wallet:hot-address
#
# Keep only a working float here. Its key is on the server, so this balance is
# what a server compromise costs. The bulk stays in TREASURY_ADDRESS, whose key
# is not on any server.
#
# The indexer reads this too, to book refills from the treasury — it holds no
# keys itself, which is why the address is configured rather than derived. The
# sweeper refuses to start if the two disagree.
HOT_WALLET_ADDRESS=

# Payouts are broadcast only when this is exactly "true", independently of
# SWEEP_BROADCAST: it is the one flow that sends money to addresses we do not own.
PAYOUT_BROADCAST=false
